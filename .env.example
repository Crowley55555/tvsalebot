# =====================================================================
# tvsalebot — пример переменных окружения
# =====================================================================
# Как пользоваться:
#   1) Скопируй этот файл в .env           (cp .env.example .env)
#   2) Проставь реальные значения ЛОКАЛЬНО. Файл .env в репозиторий НЕ попадает (.gitignore).
#   3) Любое новое поле — добавляй сначала сюда (с плейсхолдером), потом в .env.
#
# Правила этих значений — см. architecture/00-правила-проекта.md (П2, П6, П7).
# =====================================================================


# ---------------------------------------------------------------------
# секреты-провайдеров
# ---------------------------------------------------------------------

# Ключ GigaChat (основной LLM для MVP).
# Получить: developers.sber.ru → личный кабинет → GigaChat API → «Создать ключ авторизации».
# Freemium 40 млн токенов Pro на год — хватит на MVP и демо.
GIGACHAT_API_KEY=<GIGACHAT_AUTH_KEY>

# Scope ключа GigaChat. Для юрлица — GIGACHAT_API_CORP, для физлица/демо — GIGACHAT_API_PERS.
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Ключ YandexGPT (fallback-провайдер, подключается только с явного «ок», см. П6).
# Получить: console.yandex.cloud → сервисный аккаунт с ролью ai.languageModels.user → API-ключ.
YANDEX_API_KEY=<YANDEX_API_KEY>
YANDEX_FOLDER_ID=<YANDEX_FOLDER_ID>

# OpenRouter — ТОЛЬКО для dev-скриптов с анонимными данными (см. П7б). В проде запрещён.
# Получить: openrouter.ai → Keys. Оставь пустым, если не используется.
OPENROUTER_API_KEY=

# Токен Telegram-бота.
# Получить: @BotFather → /newbot → название → username → копировать токен.
BOT_TOKEN=<TELEGRAM_BOT_TOKEN>


# ---------------------------------------------------------------------
# база
# ---------------------------------------------------------------------
# В MVP отдельной SQL-базы нет: всё состояние живёт в Redis (секция «хранилище»).
# Любое добавление БД — только через П6 (спросить разрешения).


# ---------------------------------------------------------------------
# хранилище
# ---------------------------------------------------------------------

# Redis — хранит историю диалога, профиль покупателя, факт согласия ФЗ-152 (П4).
# Для локалки — локальный Redis или docker-compose. Для прода — Redis Managed (Timeweb/Yandex Cloud).
REDIS_URL=redis://localhost:6379/0

# Пароль Redis (если провайдер требует). Для локального Redis обычно пусто.
REDIS_PASSWORD=

# TTL ключа диалога в секундах. По умолчанию — 7 дней (604800); меняется только через П6.
REDIS_TTL_SECONDS=604800


# ---------------------------------------------------------------------
# оплата
# ---------------------------------------------------------------------
# Приёма платежей в самом боте в MVP нет (платежи клиента за разработку идут вне бота).
# Если появится прод-биллинг LLM или интеграция с кассой — добавлять через П6.


# ---------------------------------------------------------------------
# бизнес-конфиг
# ---------------------------------------------------------------------

# Окружение. Допустимо: dev | prod.
# В prod запрещены любые зарубежные LLM-провайдеры (П7б).
ENVIRONMENT=dev

# Активный LLM-провайдер. В prod допустимо только: gigachat | yandex.
# В dev дополнительно разрешён: openrouter (только с анонимными тестовыми данными).
LLM_PROVIDER=gigachat

# Конкретная модель внутри выбранного провайдера.
# Для gigachat — рекомендуется GigaChat-2-Pro (Freemium). Альтернативы: GigaChat-2-Lite, GigaChat-2-Max.
# Для yandex — yandexgpt/latest (5.1 Pro).
LLM_MODEL=GigaChat-2-Pro

# Максимум сообщений истории, передаваемых в LLM в одном запросе (экономия токенов + качество).
MAX_HISTORY_MESSAGES=30

# URL политики обработки персональных данных (кнопка в /start, см. principles.md § 6.1).
# Хостится на лендосе: https://<твой-домен>/privacy
PRIVACY_POLICY_URL=https://example.com/privacy

# Контакт разработчика, отправляется по команде /для_магазина (TG-username без @).
SUPPORT_CONTACT=your_telegram_username

# Telegram user_id администратора (твой) — для служебных уведомлений/алертов.
# Узнать: написать боту @userinfobot.
ADMIN_USER_ID=0
